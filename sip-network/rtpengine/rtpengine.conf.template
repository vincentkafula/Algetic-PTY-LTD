[rtpengine]
# NOT runtime-tested the way kamailio.cfg was — installing rtpengine-daemon
# hit an unrelated broken package mirror during development (a missing
# libmysqlclient21 build in the chain) that blocked getting the actual
# binary running to verify this file. The keys below match documented,
# working real-world rtpengine deployments, but test this specific file
# on your VPS before relying on it — see sip-network/README.md.

# Substituted from .env by the entrypoint script — don't hand-edit this
# file directly.
interface = __RTPENGINE_PUBLIC_IP__

# Userspace mode (no kernel module) — simpler to deploy, sufficient for a
# private network's traffic volume. High call volume (hundreds of
# concurrent calls) is where in-kernel forwarding becomes worth the extra
# setup; not needed here.
foreground = true
log-stderr = true
log-level = 6

# Control protocol port Kamailio talks to (matches rtpengine_sock in
# kamailio.cfg.template — keep these in sync if you change either).
listen-ng = 127.0.0.1:12221

# Actual RTP media flows through this port range — this range must be
# opened on the VPS firewall (UDP) alongside 5060, see README.
port-min = __RTP_PORT_MIN__
port-max = __RTP_PORT_MAX__
