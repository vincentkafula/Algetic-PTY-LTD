# Copy to .env and fill in real values before running docker compose up.
# NEVER commit .env or paste real values into a chat/AI tool.

# This VPS's actual public IP address — not 0.0.0.0, not a private/LAN IP.
# Both Kamailio and rtpengine bind to this so SIP/RTP headers carry an
# address phones on the internet can actually reach.
SIP_PUBLIC_IP=203.0.113.10
RTPENGINE_PUBLIC_IP=203.0.113.10

# The domain/hostname your SIP addresses use. Every subscriber registers
# as username@this-value, e.g. alice@sip.yourbrand.com. Point an A record
# at SIP_PUBLIC_IP if you want a real hostname rather than using the bare
# IP here.
SIP_DOMAIN=sip.yourbrand.com

# The UDP port range rtpengine uses for actual call audio. Must match
# whatever range you open on the VPS firewall (see README). A few thousand
# ports is plenty for a private team network; each concurrent call uses 2.
RTP_PORT_MIN=30000
RTP_PORT_MAX=31000

# --- Management API (lets the Altegic dashboard add/remove SIP users) ---

# A long random secret shared between this API and Altegic's backend.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Treat this like a root password for your subscriber list — anyone with
# it can add, change, or remove any SIP user's credentials.
SIP_API_KEY=

# A hostname that resolves (via a DNS A record) to this VPS's public IP.
# Caddy uses this to automatically obtain a Let's Encrypt TLS certificate
# — e.g. sipapi.yourbrand.com. This is DIFFERENT from SIP_DOMAIN above
# (that one is what phones register to; this one is just for the
# management API's own HTTPS endpoint) — they can be the same VPS, but
# give the API its own subdomain so it's clear which is which.
API_DOMAIN=
