# Copy this file to .env and fill in your own values.
# NEVER commit .env or paste real keys into a chat/AI tool.

PORT=4000

# --- Accounts / sessions ---
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this invalidates all existing login sessions.
JWT_SECRET=

# --- Email (Mailgun) ---
# https://app.mailgun.com/mg/dashboard -> Sending -> Domain settings
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mail.yourbrand.com
# Base URL differs for EU-region Mailgun accounts: https://api.eu.mailgun.net/v3
MAILGUN_BASE_URL=https://api.mailgun.net/v3

# --- Voice / Numbers (Twilio) ---
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Comma-separated list of country codes you currently support for number search.
# China (CN) is intentionally left out by default - see README "China" section.
SUPPORTED_NUMBER_COUNTRIES=US,CA,GB

# Account/mailbox/number data is stored in server/data/db.json (created
# automatically on first run). Back that file up; it's the only copy of
# your customer accounts in this starter. See README for swapping in a
# real database before going live.
