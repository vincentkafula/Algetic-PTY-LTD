# Copy this file to .env and fill in your own values.
# NEVER commit .env or paste real keys into a chat/AI tool.

PORT=4000

# --- Accounts / sessions ---
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this invalidates all existing login sessions.
JWT_SECRET=

# --- Email (Mailgun) ---
# https://app.mailgun.com/mg/dashboard -> Sending -> Domain settings
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mail.yourbrand.com
# Base URL differs for EU-region Mailgun accounts: https://api.eu.mailgun.net/v3
MAILGUN_BASE_URL=https://api.mailgun.net/v3

# Required for inbound mail to actually show up in the dashboard.
# This app's own public URL, no trailing slash — e.g. what you'd type into
# a browser to reach this deployment (a Railway domain, your own domain,
# etc.). Used to build the Mailgun inbound-route callback URL AND the
# Twilio call-centre TwiML webhook URLs (see the "Call centre" section of
# the README) — both features share this one variable. Without it,
# mailbox creation still works but inbound mail only plain-forwards and
# won't be captured or shown here, and assigning a number to an IVR menu
# will fail with a clear error instead of silently misconfiguring Twilio.
PUBLIC_BASE_URL=

# Mailgun dashboard -> Settings -> API Keys -> "HTTP webhook signing key".
# This is a DIFFERENT key from MAILGUN_API_KEY — it's what proves an
# incoming webhook call genuinely came from Mailgun and not someone who
# guessed your mailbox IDs. Required (along with PUBLIC_BASE_URL above)
# for inbound capture; without it, inbound mail is not captured.
MAILGUN_WEBHOOK_SIGNING_KEY=your_webhook_signing_key_here

# --- Voice / Numbers (Twilio) ---
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Comma-separated list of country codes you currently support for number search.
# China (CN) is intentionally left out - see README "China" section.
#
# South Africa (ZA) and Zambia (ZM) are included below, but read this first:
# - ZA: Twilio does sell South African numbers, but local/mobile numbers there
#   require a Twilio "regulatory bundle" (proof of address) approved on your
#   account before a purchase will succeed - a search can return results that
#   still fail to provision until that's done. See Twilio's regulatory
#   requirements for South Africa in your console.
# - ZM: Twilio has confirmed voice and SMS coverage for Zambia, but whether
#   *local* Zambian numbers are available for purchase via the API is not
#   something this project has verified. Test a number search for ZM in your
#   own Twilio console before relying on it - if it returns nothing, Zambia
#   numbers may need to be requested from Twilio support rather than bought
#   directly, and you may want to remove ZM from this list until confirmed.
SUPPORTED_NUMBER_COUNTRIES=US,CA,GB,ZA,ZM

# --- Private SIP network (optional, see /sip-network in this repo) ---
# Only needed if you've deployed the separate sip-network/ stack to your
# own VPS. Lets this dashboard's "Private SIP Network" panel add/list/
# remove SIP subscribers instead of using sip-network/scripts/*.sh
# directly. Leave both blank to leave that panel showing a "not
# configured" message.

# The public URL of the management API from sip-network/ — e.g.
# https://sipapi.yourbrand.com (the API_DOMAIN you set in
# sip-network/.env, fronted by the Caddy container there).
SIP_NETWORK_API_URL=

# Must match SIP_API_KEY in sip-network/.env exactly — this is the shared
# secret the two sides use to authenticate to each other.
SIP_NETWORK_API_KEY=

# --- Domain registration (GoDaddy) ---
# GoDaddy Developer dashboard -> generate a Personal Access Token.
# IMPORTANT: registering a domain charges the payment profile on this
# GoDaddy account and is NOT reversible — see the "Domain registration"
# section of the README before enabling this in a live deployment.
GODADDY_PAT=

# Account/mailbox/number/message data is stored in server/data/db.json
# (created automatically on first run). Back that file up; it's the only
# copy of your customer accounts and captured mail in this starter. See
# README for swapping in a real database before going live.
