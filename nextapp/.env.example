# Copy this file to .env.local for local development (Next.js loads
# .env.local automatically — no dotenv package needed, unlike the
# Express version this is being migrated from).

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Data storage ---
# Where server/data/db.json (now nextapp/data/db.json) lives. Leave blank
# to use the default (a `data/` folder at the project root, resolved via
# process.cwd() — see src/lib/db.js for why this isn't a __dirname-relative
# path).
DATA_DIR=

# More variables (Mailgun, Twilio, GoDaddy) will be added here as each
# service is ported over from the Express app — see nextapp/README.md
# for migration progress.

# --- Customer billing (PayFast) ---
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
MARKUP_PERCENT=25

# The public URL this app is reachable at — required for PayFast's ITN
# webhook and checkout return/cancel URLs to reach this server.
PUBLIC_BASE_URL=
