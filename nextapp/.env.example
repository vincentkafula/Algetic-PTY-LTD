# Copy this file to .env.local for local development (Next.js loads
# .env.local automatically — no dotenv package needed, unlike the
# Express version this is being migrated from).

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Data storage ---
# Where server/data/db.json (now nextapp/data/db.json) lives. Leave blank
# to use the default (a `data/` folder at the project root, resolved via
# process.cwd() — see src/lib/db.js for why this isn't a __dirname-relative
# path).
DATA_DIR=

# --- Voice (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SUPPORTED_NUMBER_COUNTRIES=US,CA,GB,ZA,ZM

# More variables (Mailgun, Twilio, GoDaddy) will be added here as each
# service is ported over from the Express app — see nextapp/README.md
# for migration progress.

# --- Customer billing (PayFast) ---
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# REQUIRED (not optional) for phone numbers and mailboxes, which bill
# monthly via PayFast Subscriptions - PayFast rejects subscription
# checkouts without a passphrase. Domains remain a once-off charge and
# don't need one, but set this regardless since numbers/mailboxes do.
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
MARKUP_PERCENT=25

# --- Email (Mailgun) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=
MAILGUN_WEBHOOK_SIGNING_KEY=
# Mailgun has no natural per-mailbox price - a real business decision,
# left unset on purpose. See src/app/api/mailboxes/route.js.
MAILBOX_MONTHLY_PRICE_USD_CENTS=

# The public URL this app is reachable at — required for PayFast's ITN
# webhook and checkout return/cancel URLs to reach this server.
PUBLIC_BASE_URL=
